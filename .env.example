```env
# ============================================================
# DATABASE - MySQL
# ============================================================

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=hospital_db
MYSQL_USER=hospital_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Docker Compose MySQL service name is "db"
DATABASE_URL=mysql+pymysql://hospital_app:CHANGE_ME_DATABASE_PASSWORD@db:3306/hospital_db


# ============================================================
# OLLAMA
# ============================================================

# When Ollama runs on the Docker host
OLLAMA_HOST=http://host.docker.internal:11434

OLLAMA_MODEL=llama3.2:3b


# ============================================================
# APPLICATION SECURITY
# ============================================================

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_JWT_SECRET


# ============================================================
# TWILIO
# ============================================================

TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=CHANGE_ME_TWILIO_FROM_NUMBER


# ============================================================
# GMAIL / SMTP
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_GMAIL_ADDRESS
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_FROM=CHANGE_ME_GMAIL_ADDRESS


# ============================================================
# GOOGLE / GEMINI
# ============================================================

GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY

GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com


# ============================================================
# WHATSAPP CLOUD API
# ============================================================

WHATSAPP_TOKEN=CHANGE_ME_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID

WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_VERIFY_TOKEN
WHATSAPP_API_VERSION=v25.0
```
